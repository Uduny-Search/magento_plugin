<?xml version="1.0"?>
<!--
/**
 * Default Frontend Layout
 *
 * Loads the session tracking block on frontend pages when the module is enabled.
 * The AMD JS module is loaded on demand via text/x-magento-init in tracking.phtml.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>
        <!-- Reference the before.body.end container to add our tracking block -->
        <referenceContainer name="before.body.end">
            <block class="UnusualDope\Uduny\Block\Tracking"
                   name="uduny.tracking"
                   template="UnusualDope_Uduny::tracking.phtml"
                   ifconfig="uduny/general/enabled"/>
        </referenceContainer>
    </body>

</page>
