        <span>
            <?= $block->escapeHtml(__('Debug mode is currently disabled. Enable it in Stores → Configuration → Uduny → Debug Mode to start logging.')) ?>
        </span>
    </div>
    <?php else: ?>
    <div class="message message-success">
        <span>
            <?= $block->escapeHtml(__('Debug mode is enabled. Logs are being written to: %1', $logDirectory)) ?>
        </span>
    </div>
    <?php endif; ?>

    <!-- Action Buttons -->
    <div class="admin__page-actions" style="margin: 20px 0;">
        <button type="button" class="action-primary" id="uduny-refresh-btn">
            <span><?= $block->escapeHtml(__('Refresh')) ?></span>
        </button>
        <button type="button" class="action-secondary" id="uduny-clear-btn" <?= empty($logFiles) ? 'disabled' : '' ?>>
            <span><?= $block->escapeHtml(__('Clear All Logs')) ?></span>
        </button>
    </div>

    <!-- Log Files List -->
    <div class="admin__data-grid-outer-wrap" style="margin-bottom: 20px;">
        <div class="admin__data-grid-header">
            <span class="admin__data-grid-header-text">
                <?= $block->escapeHtml(__('Log Files')) ?>
                (<span id="uduny-file-count"><?= count($logFiles) ?></span>)
            </span>
        </div>

        <table class="data-grid" id="uduny-log-table">
            <thead>
                <tr>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Filename')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Size')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Last Modified')) ?></th>
                    <th class="data-grid-th"><?= $block->escapeHtml(__('Actions')) ?></th>
                </tr>
            </thead>
            <tbody id="uduny-log-list">
                <?php if (empty($logFiles)): ?>
                <tr class="uduny-empty-row">
                    <td colspan="4" class="empty-text" style="text-align: center; padding: 20px;">
                        <?= $block->escapeHtml(__('No log files found.')) ?>
                    </td>
                </tr>
                <?php else: ?>
                    <?php foreach ($logFiles as $file): ?>
                    <tr data-filename="<?= $block->escapeHtmlAttr($file['filename']) ?>">
                        <td>📄 <?= $block->escapeHtml($file['filename']) ?></td>
                        <td><?= $block->escapeHtml($file['size']) ?></td>
                        <td><?= $block->escapeHtml($file['modified']) ?></td>
                        <td>
                            <button type="button" class="action-default uduny-view-btn" data-filename="<?= $block->escapeHtmlAttr($file['filename']) ?>">
                                <?= $block->escapeHtml(__('View')) ?>
                            </button>
                            <button type="button" class="action-default uduny-delete-btn" data-filename="<?= $block->escapeHtmlAttr($file['filename']) ?>">
                                <?= $block->escapeHtml(__('Delete')) ?>
                            </button>
                        </td>
                    </tr>
                    <?php endforeach; ?>
                <?php endif; ?>
            </tbody>
        </table>
    </div>

    <!-- Log Contents Viewer -->
    <div class="admin__data-grid-outer-wrap" id="uduny-log-viewer" style="display: none;">
        <div class="admin__data-grid-header">
            <span class="admin__data-grid-header-text">
                <?= $block->escapeHtml(__('Log Contents:')) ?>
                <span id="uduny-current-file"></span>
            </span>
            <button type="button" class="action-tertiary" id="uduny-close-viewer" style="float: right;">
                <?= $block->escapeHtml(__('Close')) ?>
            </button>
        </div>
        <div style="padding: 15px; background: #1a1a1a; border-radius: 4px; max-height: 500px; overflow: auto;">
            <pre id="uduny-log-contents" style="color: #00ff00; font-family: monospace; font-size: 12px; margin: 0; white-space: pre-wrap;"></pre>
        </div>
    </div>

</div>

<style>
    .uduny-debug-page .data-grid {
        width: 100%;
    }
    .uduny-debug-page .data-grid th,
    .uduny-debug-page .data-grid td {
        padding: 10px 15px;
        text-align: left;
        border-bottom: 1px solid #e3e3e3;
    }
    .uduny-debug-page .data-grid tbody tr:hover {
        background-color: #f5f5f5;
    }
    .uduny-debug-page .action-default {
        margin-right: 5px;
    }
    .uduny-debug-page #uduny-log-viewer {
        margin-top: 20px;
    }
    .uduny-debug-page .admin__data-grid-header {
        padding: 15px;
        background: #f8f8f8;
        border-bottom: 1px solid #e3e3e3;
        font-weight: 600;
    }
</style>

<script>
require(['jquery'], function($) {
    'use strict';

    var config = {
        refreshUrl: '<?= $block->escapeJs($block->getRefreshUrl()) ?>',
        viewUrl: '<?= $block->escapeJs($block->getViewUrl()) ?>',
        deleteUrl: '<?= $block->escapeJs($block->getDeleteUrl()) ?>',
        clearUrl: '<?= $block->escapeJs($block->getClearUrl()) ?>'
    };

    // Refresh log files list
    function refreshList() {
        $.ajax({
            url: config.refreshUrl,
            type: 'GET',
            dataType: 'json',
            showLoader: true,
            success: function(response) {
                if (response.success) {
                    updateTable(response.files);
                    $('#uduny-file-count').text(response.count);
                    $('#uduny-clear-btn').prop('disabled', response.count === 0);
                }
            },
            error: function() {
                alert('<?= $block->escapeJs(__('Error refreshing log files')) ?>');
            }
        });
    }

    // Update table with new file list
    function updateTable(files) {
        var $tbody = $('#uduny-log-list');
        $tbody.empty();

        if (files.length === 0) {
            $tbody.append(
                '<tr class="uduny-empty-row"><td colspan="4" class="empty-text" style="text-align: center; padding: 20px;">' +
                '<?= $block->escapeJs(__('No log files found.')) ?>' +
                '</td></tr>'
            );
            return;
        }

        files.forEach(function(file) {
            var row = '<tr data-filename="' + file.filename + '">' +
                '<td>📄 ' + file.filename + '</td>' +
                '<td>' + file.size + '</td>' +
                '<td>' + file.modified + '</td>' +
                '<td>' +
                '<button type="button" class="action-default uduny-view-btn" data-filename="' + file.filename + '"><?= $block->escapeJs(__('View')) ?></button> ' +
                '<button type="button" class="action-default uduny-delete-btn" data-filename="' + file.filename + '"><?= $block->escapeJs(__('Delete')) ?></button>' +
                '</td></tr>';
            $tbody.append(row);
        });
    }

    // View log file
    function viewLog(filename) {
        $.ajax({
            url: config.viewUrl,
            type: 'GET',
            data: { filename: filename },
            dataType: 'json',
            showLoader: true,
            success: function(response) {
                if (response.success) {
                    $('#uduny-current-file').text(response.filename);
                    $('#uduny-log-contents').text(response.contents);
                    $('#uduny-log-viewer').show();
                    // Scroll to bottom of log
                    var $pre = $('#uduny-log-contents');
                    $pre.parent().scrollTop($pre.parent()[0].scrollHeight);
                } else {
                    alert(response.message);
                }
            },
            error: function() {
                alert('<?= $block->escapeJs(__('Error loading log file')) ?>');
            }
        });
    }

    // Delete log file
    function deleteLog(filename) {
        if (!confirm('<?= $block->escapeJs(__('Are you sure you want to delete this log file?')) ?>')) {
            return;
        }

        $.ajax({
            url: config.deleteUrl,
            type: 'POST',
            data: {
                filename: filename,
                form_key: window.FORM_KEY
            },
            dataType: 'json',
            showLoader: true,
            success: function(response) {
                if (response.success) {
                    // Remove row from table
                    $('tr[data-filename="' + filename + '"]').fadeOut(function() {
                        $(this).remove();
                        var count = $('#uduny-log-list tr:not(.uduny-empty-row)').length;
                        $('#uduny-file-count').text(count);
                        if (count === 0) {
                            updateTable([]);
                        }
                        $('#uduny-clear-btn').prop('disabled', count === 0);
                    });
                    // Hide viewer if showing deleted file
                    if ($('#uduny-current-file').text() === filename) {
                        $('#uduny-log-viewer').hide();
                    }
                } else {
                    alert(response.message);
                }
            },
            error: function() {
                alert('<?= $block->escapeJs(__('Error deleting log file')) ?>');
            }
        });
    }

    // Clear all logs
    function clearAll() {
        if (!confirm('<?= $block->escapeJs(__('Are you sure you want to delete ALL log files?')) ?>')) {
            return;
        }

        $.ajax({
            url: config.clearUrl,
            type: 'POST',
            data: { form_key: window.FORM_KEY },
            dataType: 'json',
            showLoader: true,
            success: function(response) {
                if (response.success) {
                    updateTable([]);
                    $('#uduny-file-count').text(0);
                    $('#uduny-log-viewer').hide();
                    $('#uduny-clear-btn').prop('disabled', true);
                    alert(response.message);
                }
            },
            error: function() {
                alert('<?= $block->escapeJs(__('Error clearing log files')) ?>');
            }
        });
    }

    // Event handlers
    $('#uduny-refresh-btn').on('click', refreshList);
    $('#uduny-clear-btn').on('click', clearAll);
    $('#uduny-close-viewer').on('click', function() {
        $('#uduny-log-viewer').hide();
    });

    // Delegated events for dynamic elements
    $(document).on('click', '.uduny-view-btn', function() {
        viewLog($(this).data('filename'));
    });

    $(document).on('click', '.uduny-delete-btn', function() {
        deleteLog($(this).data('filename'));
    });
});
</script>

